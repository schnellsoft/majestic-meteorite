---
import Dogs from '../components/Dogs.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Meet the pack: dog profiles, breeds, and wellbeing';
const description =
	'Profiles for every dog in the pack, with breed, age, health notes, and a short story about how each one spends the day. Open any profile to read more.';
---

<Layout title={title} description={description}>
	<main>
		<Dogs />
	</main>
</Layout>
